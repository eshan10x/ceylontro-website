---
/**
 * Base document: metadata, structured data, fonts, skip link. Every page uses this layout.
 * Search rules (launch gate, social image) live in `src/lib/seo.ts`.
 */
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import cormorant500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import manrope400 from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import { site } from '@/config/site';
import logo from '@/assets/brand/ceylontro-logo.jpg';
import { DEFAULT_OG_IMAGE, cleanPath, launched } from '@/lib/seo';
import { menuJsonLd, restaurantJsonLd } from '@/lib/structured-data';

type StructuredData = 'restaurant' | 'menu';

interface Props {
  /** Page title; the brand name is appended automatically. Omit on the home page. */
  title?: string;
  description?: string;
  /** Keep the page out of search results (style guide, 404, pages without the owner's content). */
  noindex?: boolean;
  /** Social image (root-relative, 1200 × 630) and its alt text; defaults to the brand card. */
  ogImage?: { path: string; alt: string; width: number; height: number };
  /** Schema.org JSON-LD blocks for this page, built from verified data only. */
  structuredData?: readonly StructuredData[];
}

const {
  title,
  description = site.description,
  noindex = false,
  ogImage = DEFAULT_OG_IMAGE,
  structuredData = [],
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
// Launch gate: nothing is indexable until the owner's domain is set.
const robots = noindex || !launched ? 'noindex, nofollow' : undefined;
const pageUrl = Astro.site ? new URL(cleanPath(Astro.url.pathname), Astro.site).href : undefined;
// A canonical link only on indexable pages, so it never contradicts a noindex.
const canonical = robots ? undefined : pageUrl;
const ogImageUrl = Astro.site ? new URL(ogImage.path, Astro.site).href : undefined;

const jsonLd: object[] = [];
if (structuredData.includes('restaurant')) {
  const logoFile = await getImage({ src: logo, width: 512, height: 512, format: 'png' });
  jsonLd.push(restaurantJsonLd(Astro.site, { logo: logoFile.src, social: DEFAULT_OG_IMAGE.path }));
}
if (structuredData.includes('menu')) jsonLd.push(menuJsonLd(Astro.site));
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={site.locale} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content={String(ogImage.width)} />
          <meta property="og:image:height" content={String(ogImage.height)} />
          <meta property="og:image:alt" content={ogImage.alt} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={ogImage.alt} />}

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={cormorant500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope400} as="font" type="font/woff2" crossorigin />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="label fixed top-3 left-3 z-50 -translate-y-24 rounded-full bg-espresso px-5 py-3 text-white transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
