---
/**
 * Standard page: header, drawer, <main> and footer around the page content.
 * Pages whose first section is a hero pass `overlayHeader` and start that section with
 * the `pt-header` utility; other pages get a spacer so content starts below the header.
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '@/components/shell/SiteHeader.astro';
import MobileNav from '@/components/shell/MobileNav.astro';
import SiteFooter from '@/components/shell/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: { path: string; alt: string; width: number; height: number };
  structuredData?: readonly ('restaurant' | 'menu')[];
  /** Header is transparent over the first section until the page scrolls. */
  overlayHeader?: boolean;
  /** Tone of that first section, so the transparent header can switch to cream on a dark hero. */
  heroTone?: 'light' | 'dark';
}

const { overlayHeader = false, heroTone = 'light', ...meta } = Astro.props;
---

<BaseLayout {...meta}>
  <slot name="head" slot="head" />
  <SiteHeader overlay={overlayHeader} tone={heroTone} />
  <MobileNav />
  <main id="main" tabindex="-1" class="outline-none">
    {!overlayHeader && <div aria-hidden="true" class="h-(--header-h)"></div>}
    <slot />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import '@/scripts/shell';
  import '@/scripts/reveal';
</script>
