---
/**
 * Menu page intro (D3 "MenuMobile" / "MenuDesktop"): the owner's printed line as eyebrow,
 * "The Menu" title, a short line, and a key to the dietary markers in use.
 */
import PageIntro from '@/components/layout/PageIntro.astro';
import DietaryMarker from '@/components/ui/DietaryMarker.astro';
import { copy } from '@/data/copy';
import { allMenuItems } from '@/data/menu';
import type { DietaryTag } from '@/data/types';

// Only explain markers that actually appear on the menu.
const order: readonly DietaryTag[] = ['spicy', 'vegetarian'];
const tagsInUse = order.filter((tag) => allMenuItems().some((item) => item.tags.includes(tag)));
---

<PageIntro eyebrow={copy.freshBold.text} title="The Menu" titleId="menu-title" archPhoto="menu-intro" sidePhoto="menu-intro-side">
  <p class="max-w-[27.5rem] text-[0.875rem] leading-relaxed text-stone md:text-small">{copy.menuIntro.text}</p>
  {
    tagsInUse.length > 0 && (
      <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list" aria-label="Menu markers">
        {tagsInUse.map((tag) => (
          <li>
            <DietaryMarker kind={tag} />
          </li>
        ))}
      </ul>
    )
  }
</PageIntro>
