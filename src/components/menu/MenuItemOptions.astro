---
/**
 * An item's choices (sauce, side, flavour) and paid extras, as printed on the menu.
 * - `pills`: static pills, for featured cards.
 * - `text`: one compact line per group, for menu rows and category headers.
 * Information only: nothing here is selectable until online ordering exists.
 */
import Pill from '@/components/ui/Pill.astro';
import type { MenuExtraGroup, MenuOptionGroup } from '@/data/types';

interface Props {
  groups?: readonly MenuOptionGroup[] | undefined;
  extras?: readonly MenuExtraGroup[] | undefined;
  variant?: 'pills' | 'text';
  /** Right-aligned lines, for the category header on wide screens. */
  alignEnd?: boolean;
  class?: string | undefined;
}

const { groups = [], extras = [], variant = 'text', alignEnd = false, class: className } = Astro.props;

const lines = [
  ...groups.map((group) => ({ label: group.label, values: group.values.map((value) => ({ name: value, price: '' })) })),
  ...extras,
];
const line = ['flex flex-wrap items-baseline gap-x-2 text-[0.8125rem] leading-normal', alignEnd && 'md:justify-end'];
---

{
  lines.length > 0 && (
    <dl class:list={['flex flex-col', variant === 'pills' ? 'gap-3' : 'gap-1', className]}>
      {lines.map((group) =>
        variant === 'pills' ? (
          <div class="flex flex-col gap-2">
            <dt class="label text-stone">{group.label}</dt>
            <dd>
              <ul class="flex flex-wrap gap-1.5" role="list">
                {group.values.map((value) => (
                  <li>
                    <Pill size="sm">
                      {value.name}
                      {value.price && <span class="pl-1.5 font-semibold tabular-nums">{value.price}</span>}
                    </Pill>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ) : (
          <div class:list={line}>
            <dt class="text-stone">{group.label}</dt>
            <dd class="font-medium text-ink">
              {group.values.map((value, i) => (
                <>
                  {i > 0 && <span aria-hidden="true" class="text-stone"> · </span>}
                  <span class="whitespace-nowrap">
                    {value.name}
                    {value.price && <span class="tabular-nums"> {value.price}</span>}
                  </span>
                </>
              ))}
            </dd>
          </div>
        ),
      )}
    </dl>
  )
}
