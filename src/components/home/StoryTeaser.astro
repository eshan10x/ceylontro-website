---
/**
 * Our Story teaser (D3 Home): the logo plaque inside an espresso arch beside the story
 * heading. The introduction appears only once the owner has written it.
 */
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import LogoArch from '@/components/ui/LogoArch.astro';
import MissingData from '@/components/ui/MissingData.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { copy } from '@/data/copy';
import { story } from '@/data/story';
import { splitAccent } from '@/lib/text';

const heading = splitAccent(copy.storyHeading.text);
const intro = story.intro?.[0];
---

<Section surface="linen" labelledby="story-teaser-title">
  <Container class="grid items-center justify-items-center gap-5 text-center lg:grid-cols-12 lg:gap-x-6 lg:justify-items-start lg:text-left">
    <div class="flex justify-center lg:col-span-4 lg:col-start-2 lg:w-full">
      <LogoArch class="w-[15.625rem] lg:w-full lg:max-w-[25rem]" />
    </div>

    <div class="flex max-w-xl flex-col items-center gap-5 lg:col-span-5 lg:col-start-7 lg:items-start lg:gap-6">
      <Eyebrow>Our Story</Eyebrow>
      <h2 id="story-teaser-title" class="text-h2 text-ink lg:text-[clamp(3.5rem,5vw,4.5rem)] lg:leading-[0.98]">
        {heading.lead}{' '}<i>{heading.accent}</i>
      </h2>
      {intro ? <p class="text-stone">{intro}</p> : <MissingData label="Story introduction" class="self-center lg:self-start" />}
      <TextLink href="/our-story">Read our story</TextLink>
    </div>
  </Container>
</Section>
