---
/**
 * Home hero, "After dark" (B8, approved 2026-10-28; replaces the D3 editorial stage).
 *
 * An espresso stage where the owner's dark, moody food photography belongs: the photo stands in
 * a tall arch (the logo's arch) and dissolves into the background at its foot, so it reads as
 * lit food in a dark room rather than a picture pasted on a page. Type never crosses the food.
 * The foot of the hero carries the two facts a hungry visitor wants: where, and how to call.
 *
 * Desktop: headline, line and actions on the left (7 columns), arch on the right (5 columns).
 * Mobile: headline, arch, line, actions, then the address and phone.
 */
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import Photo from '@/components/ui/Photo.astro';
import OrderButton from '@/components/ui/OrderButton.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { copy } from '@/data/copy';
import { getPhoto } from '@/data/images';
import { restaurant } from '@/data/restaurant';
import { addressLines, directionsHref, phoneHref } from '@/lib/format';

const hero = getPhoto('hero-dish');
const { address, phone } = restaurant;
---

<Section surface="dark" padded={false} labelledby="hero-title" class="night">
  <Container class="night__grid">
    <h1 id="hero-title" class="night__title">
      <span class="enter" style="--enter-i: 1">Flavours</span>
      <span class="enter" style="--enter-i: 2">Beyond</span>
      <span class="enter" style="--enter-i: 3">Borders</span>
    </h1>

    <div class="night__media">
      <div aria-hidden="true" class="night__outline enter rounded-arch" style="--enter-i: 4"></div>
      <Photo
        image={hero.image}
        alt={hero.alt}
        shape="arch"
        ratio="4 / 5"
        priority
        sizes="(min-width: 81rem) 520px, (min-width: 64rem) 38vw, 88vw"
        caption="Photo · Hero dish · arch"
        style="--enter-i: 2"
        class="night__photo enter-arch"
      />
    </div>

    <div class="night__body enter" style="--enter-i: 5">
      <p class="night__line">{copy.heroSupport.text}</p>
      <div class="night__actions">
        <OrderButton onDark size="lg" class="night__order" />
        <TextLink href="/menu" onDark>View the menu</TextLink>
      </div>
    </div>

    {
      (address || phone) && (
        <ul class="night__facts enter" style="--enter-i: 6" role="list">
          {address && (
            <li>
              <a href={directionsHref(address)} target="_blank" rel="noopener" class="night__fact">
                {addressLines(address).join(', ')}
                <span class="sr-only"> (directions open in a new tab)</span>
              </a>
            </li>
          )}
          {phone && (
            <li>
              <a href={phoneHref(phone)} class="night__fact">
                {phone}
              </a>
            </li>
          )}
        </ul>
      )
    }
  </Container>
</Section>

<style is:global>
  /* ---------- Mobile first: one column ---------- */
  .night__grid {
    display: grid;
    grid-template-areas:
      'title'
      'media'
      'body'
      'facts';
    row-gap: 1.75rem;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: 1.5rem;
  }

  .night__title {
    grid-area: title;
    display: flex;
    flex-direction: column;
    font-size: clamp(3.5rem, 1.6rem + 9vw, 5.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-cream);
  }

  /* The middle line steps in: the one typographic move, echoing a border being crossed. */
  .night__title span:nth-child(2) {
    padding-left: 0.62em;
  }

  .night__media {
    grid-area: media;
    position: relative;
    width: min(100%, 26rem);
    justify-self: center;
    padding: 0.875rem 0.875rem 0;
  }

  .night__outline {
    position: absolute;
    inset: 0 0 18%;
    border: 1px solid rgb(224 188 99 / 0.45);
    border-bottom: 0;
  }

  /* Dissolve the foot of the photo into the espresso stage. */
  .night__photo {
    mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
  }

  .night__body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: -2.5rem; /* tuck under the dissolved foot of the photo */
    position: relative;
  }

  .night__line {
    max-width: 32ch;
    color: var(--color-cream-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .night__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .night__order {
    width: 100%;
  }

  .night__actions > :last-child {
    white-space: nowrap;
  }

  .night__facts {
    grid-area: facts;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(245 239 228 / 0.14);
  }

  .night__fact {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-cream);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 350ms ease;
  }

  .night__fact:hover {
    color: var(--color-gold-light);
  }

  @media (width >= 40rem) {
    .night__order {
      width: auto;
    }

    .night__actions {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }

  /* ---------- Desktop: type left, arch right, facts along the foot ---------- */
  @media (width >= 64rem) {
    .night__grid {
      min-height: min(100svh, 62rem);
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: 1fr auto auto;
      grid-template-areas:
        'title title title title title title title media media media media media'
        'body  body  body  body  body  body  .     media media media media media'
        'facts facts facts facts facts facts facts facts facts facts facts facts';
      column-gap: 1.5rem;
      row-gap: 0;
      padding-top: calc(var(--header-h) + 2rem);
      padding-bottom: 2rem;
    }

    .night__title {
      align-self: end;
      font-size: clamp(6rem, 1rem + 8.6vw, 9.75rem);
      padding-bottom: 2.5rem;
    }

    .night__media {
      align-self: end;
      width: 100%;
      max-width: 34rem;
      justify-self: end;
      padding: 1.25rem 1.25rem 0;
      margin-bottom: -2rem; /* the arch stands on the facts line */
    }

    .night__body {
      margin-top: 0;
      padding-bottom: 3rem;
      gap: 2rem;
    }

    .night__facts {
      margin-top: 0;
      padding-top: 1.5rem;
      position: relative;
      z-index: 1;
    }
  }
</style>
