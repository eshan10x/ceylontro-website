---
/**
 * Home hero (D3 "Main" mobile, "HomeDesktop").
 *
 * - Mobile/tablet: eyebrow, headline, arch photo with an overlapping round side dish,
 *   support line, then Order Online and View Menu.
 * - Desktop (≥ 1024 px): an editorial "stage". The three headline words sit around the arch
 *   photo; the stage scales with container-query units, so the composition at 1440 px matches
 *   the mockup and every other width is the same picture, smaller or larger (capped at 1296 px).
 */
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Photo from '@/components/ui/Photo.astro';
import OrderButton from '@/components/ui/OrderButton.astro';
import Button from '@/components/ui/Button.astro';
import { copy } from '@/data/copy';
import { getPhoto } from '@/data/images';
import { site } from '@/config/site';

const hero = getPhoto('hero-dish');
const side = getPhoto('hero-side-dish');
---

<Section surface="hero" padded={false} class="pt-header" labelledby="hero-title">
  <Container class="pt-9 pb-12 md:pt-14 md:pb-18 lg:pt-10 lg:pb-18">
    <div class="hero">
      <Eyebrow class="hero__eyebrow enter">{site.name}</Eyebrow>

      <h1 id="hero-title" class="hero__title font-display font-medium text-ink">
        <span class="hero__word hero__word--1 enter" style="--enter-i: 1">Flavours</span>{' '}
        <span class="hero__word hero__word--2 enter text-espresso italic" style="--enter-i: 2">Beyond</span>{' '}
        <span class="hero__word hero__word--3 enter" style="--enter-i: 3">Borders</span>
      </h1>

      <div class="hero__media">
        <div aria-hidden="true" class="hero__outline enter rounded-arch border border-b-0 border-gold/55" style="--enter-i: 3"></div>
        <Photo
          image={hero.image}
          alt={hero.alt}
          shape="arch"
          ratio="25 / 34"
          priority
          elevated
          sizes="(min-width: 81rem) 500px, (min-width: 64rem) 38vw, 300px"
          caption="Photo · Hero dish · arch"
          class="hero__photo enter-arch"
        />
        <Photo
          image={side.image}
          alt={side.alt}
          shape="circle"
          ratio="1 / 1"
          ring
          elevated
          sizes="(min-width: 64rem) 220px, 124px"
          reveal={false}
          style="--enter-i: 5"
          class="hero__side enter"
        />
      </div>

      <p class="hero__support enter text-stone" style="--enter-i: 5">{copy.heroSupport.text}</p>

      <div class="hero__actions enter" style="--enter-i: 6">
        <OrderButton fullWidth class="md:w-auto" />
        <Button href="/menu" variant="secondary" fullWidth class="md:w-auto">View Menu</Button>
      </div>
    </div>
  </Container>
</Section>

<style is:global>
  /* Global because the photo classes land on child components; every selector is namespaced .hero. */
  /* ---------- Mobile and tablet: one centred column ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.375rem;
    text-align: center;
  }

  .hero__title {
    font-size: clamp(3.25rem, 1.5rem + 7.8vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.015em;
  }

  /* Inline-block so each word can rise on its own during the entrance. */
  .hero__word {
    display: inline-block;
  }

  .hero__media {
    position: relative;
    width: min(18.75rem, 78vw);
    margin: 0.375rem 0 1.375rem;
  }

  .hero__outline {
    position: absolute;
    inset: -0.75rem -0.75rem 0;
  }

  /* Mobile arch is a little squatter than desktop (300 × 380 vs 500 × 680 in the mockups). */
  .hero__photo {
    aspect-ratio: 15 / 19 !important;
  }

  .hero__side {
    position: absolute;
    z-index: 4;
    right: -1.875rem;
    bottom: -1.375rem;
    width: 41%;
  }

  .hero__support {
    max-width: 22rem;
    padding-top: 0.625rem;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    max-width: 24rem;
  }

  @media (width >= 48rem) {
    .hero__media {
      width: 21rem;
    }

    .hero__actions {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }
  }

  /* ---------- Desktop: the editorial stage (mockup coordinates / 1296 × 760) ---------- */
  @media (width >= 64rem) {
    .hero {
      display: block;
      position: relative;
      container-type: inline-size;
      aspect-ratio: 1296 / 760;
      text-align: left;
    }

    .hero > * {
      position: absolute;
    }

    .hero__eyebrow {
      left: 0.46%;
      top: 14.5%;
    }

    /* The h1 is only a wrapper; its words are placed on the stage. */
    .hero__title {
      position: static;
      max-width: none;
      font-size: 12.963cqw; /* 168 px at 1296 */
      line-height: 0.9;
    }

    .hero__word {
      position: absolute;
      z-index: 3;
      white-space: nowrap;
    }

    .hero__word--1 {
      left: 0;
      top: 21%;
    }

    .hero__word--2 {
      left: 48.5%;
      top: 40.8%;
    }

    .hero__word--3 {
      left: 8.3%;
      top: 60.5%;
    }

    .hero__photo {
      aspect-ratio: 25 / 34 !important;
    }

    .hero__media {
      left: 30.7%;
      top: 3.9%;
      width: 38.58%;
      margin: 0;
    }

    .hero__outline {
      inset: -1.852cqw -1.852cqw 0; /* 24 px at 1296 */
    }

    .hero__side {
      right: -12.8%;
      bottom: 3.1%;
      width: 44%;
    }

    .hero__support {
      left: 0;
      right: 0;
      top: 101%;
      max-width: none;
      padding: 0;
      text-align: center;
      font-size: 1rem;
    }

    .hero__actions {
      right: 0;
      top: 72.4%;
      flex-direction: column;
      width: auto;
      gap: 0.75rem;
    }
  }
</style>
