---
/** Centres content at the 1296 px content width with responsive gutters. */
interface Props {
  /** Fade the block up as it scrolls into view (see src/scripts/reveal.ts). */
  reveal?: boolean;
  class?: string | undefined;
}

const { reveal = false, class: className } = Astro.props;
---

<div data-reveal={reveal ? '' : undefined} class:list={['gutter-x mx-auto w-full max-w-[calc(var(--container-content)+9rem)]', className]}>
  <slot />
</div>
