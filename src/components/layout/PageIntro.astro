---
/**
 * Page intro for inner pages (D3 Menu and Contact): eyebrow and display title on the left,
 * an arch photo on the right, and on desktop an optional round photo overlapping it.
 * Warm hero surface with grain; the header overlays it (pages pass `overlayHeader`).
 * Extra lines under the title go in the default slot.
 */
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Photo from '@/components/ui/Photo.astro';
import { getPhoto } from '@/data/images';
import { splitAccent } from '@/lib/text';

interface Props {
  eyebrow: string;
  /** Title; its last word takes the italic accent ("Say hello" → Say *hello*). */
  title: string;
  titleId: string;
  /** Photo registry keys. */
  archPhoto: string;
  sidePhoto?: string;
}

const { eyebrow, title, titleId, archPhoto, sidePhoto } = Astro.props;
const heading = splitAccent(title);
const arch = getPhoto(archPhoto);
const side = sidePhoto ? getPhoto(sidePhoto) : null;
---

<Section surface="hero" padded={false} labelledby={titleId} class="pt-header">
  <Container class="flex items-end gap-3 pt-9 pb-7 md:gap-8 md:pt-16 md:pb-14 lg:gap-12 lg:pt-22 lg:pb-18">
    <div class="enter flex min-w-0 grow flex-col gap-3 md:gap-5">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1 id={titleId} class="text-display-l text-ink">
        {heading.lead && `${heading.lead} `}<i>{heading.accent}</i>
      </h1>
      <slot />
    </div>
    <Photo
      image={arch.image}
      alt={arch.alt}
      shape="arch"
      ratio="7 / 9"
      elevated
      priority
      sizes="(min-width: 64rem) 280px, (min-width: 48rem) 200px, 110px"
      caption="Photo · 4:5"
      style="--enter-i: 1"
      class="enter-arch w-27.5 shrink-0 md:w-50 lg:w-70"
    />
    {
      side && (
        <Photo
          image={side.image}
          alt={side.alt}
          shape="circle"
          ratio="1 / 1"
          elevated
          ring
          sizes="190px"
          reveal={false}
          style="--enter-i: 3"
          class="enter relative z-10 mb-10 -ml-24 hidden w-47.5 shrink-0 lg:block xl:-ml-20"
        />
      )
    }
  </Container>
</Section>
