---
/**
 * Our Story hero: centred title and brand line, then a carved mural of the journey from Sri Lanka
 * to Canada as a full-width band that rises from under the line and dissolves into the linen on
 * all four sides. The owner's introduction appears below once supplied.
 */
import { Picture } from 'astro:assets';
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import MissingData from '@/components/ui/MissingData.astro';
import { copy } from '@/data/copy';
import { getPhoto } from '@/data/images';
import { site } from '@/config/site';
import { story } from '@/data/story';

const mural = getPhoto('story-mural');
---

<Section surface="hero" padded={false} labelledby="story-title" class="pt-header">
  <Container class="relative z-[1] flex flex-col items-center gap-5 pt-10 text-center md:gap-6 md:pt-16 lg:pt-20">
    <Eyebrow class="enter">{site.name}</Eyebrow>
    <h1 id="story-title" class="enter text-display-l text-ink" style="--enter-i: 1">Our <i>Story</i></h1>
    <p style="--enter-i: 2" class="enter max-w-[22ch] font-display text-[1.375rem] leading-[1.15] text-stone italic md:text-[1.75rem]">
      {copy.storyHeading.text}
    </p>
  </Container>

  {
    mural.image && (
      <div class="story-mural enter" style="--enter-i: 3">
        <Picture
          src={mural.image}
          alt={mural.alt}
          formats={['avif', 'webp']}
          sizes="100vw"
          widths={[640, 960, 1280, 1600, 2000, 2400, 3200]}
          layout="none"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block size-full object-cover"
        />
      </div>
    )
  }

  <Container class="relative z-[1] flex flex-col items-center pb-14 text-center md:pb-20 lg:pb-24">
    {
      story.intro ? (
        <div class="flex max-w-[38rem] flex-col gap-4 text-body text-ink">
          {story.intro.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ) : (
        <MissingData label="Story introduction" class="self-center" />
      )
    }
  </Container>
</Section>

<style>
  /*
   * Full-bleed band at the mural's own proportions (capped), rising slightly under the brand
   * line. Long eased fades on every side; multiply lets the linen's warmth through the plaster.
   */
  .story-mural {
    position: relative;
    height: clamp(17.5rem, 44vw, 40rem);
    margin-top: -1.5rem;
    mix-blend-mode: multiply;
    --fade-x: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.4) 8%, #000 20%, #000 80%, rgb(0 0 0 / 0.4) 92%, transparent 100%);
    --fade-y: linear-gradient(to bottom, transparent 0%, rgb(0 0 0 / 0.35) 10%, #000 26%, #000 74%, rgb(0 0 0 / 0.35) 90%, transparent 100%);
    mask-image: var(--fade-x), var(--fade-y);
    mask-composite: intersect;
    -webkit-mask-image: var(--fade-x), var(--fade-y);
    -webkit-mask-composite: source-in;
  }

  /* Phones see the centre of the journey: the crossing, flanked by both shores. */
  .story-mural :global(img) {
    object-position: 50% 50%;
  }

  @media (width >= 48rem) {
    .story-mural {
      margin-top: -3rem;
    }
  }
</style>
