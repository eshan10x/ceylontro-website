---
/**
 * Our Story closing band (D3 "StoryMobile"): the page's one espresso band — the draft line
 * "Taste the story" with Order Online (cream) and View Menu (outline).
 */
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import Button from '@/components/ui/Button.astro';
import OrderButton from '@/components/ui/OrderButton.astro';
import { copy } from '@/data/copy';
---

<Section surface="dark" labelledby="story-cta-title" padded={false} class="py-20 md:py-28 lg:py-[8.75rem]">
  <div
    aria-hidden="true"
    class="rounded-arch pointer-events-none absolute top-10 left-1/2 aspect-[5/6] w-[16rem] -translate-x-1/2 border border-b-0 border-gold-light/35 md:w-[22rem] lg:top-16 lg:w-[28rem]"
  >
  </div>
  <Container class="relative flex flex-col items-center gap-8 text-center lg:gap-10">
    <h2 id="story-cta-title" class="text-display-l text-cream italic">{copy.storyCta.text}</h2>
    <div class="flex w-full max-w-xs flex-col gap-2.5 md:w-auto md:max-w-none md:flex-row md:gap-3">
      <OrderButton onDark fullWidth class="md:w-auto" />
      <Button href="/menu" variant="outline-dark" fullWidth class="md:w-auto">View Menu</Button>
    </div>
  </Container>
</Section>
