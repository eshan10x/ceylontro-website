---
/**
 * A plate cut out of its photo (transparent PNG), set straight onto the page surface with a
 * soft two-layer shadow so it reads as sitting on the table rather than pasted on. Optimised to
 * AVIF/WebP with the transparency kept.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata | null;
  alt: string;
  sizes: string;
  priority?: boolean;
  style?: string;
  class?: string | undefined;
}

const { image, alt, sizes, priority = false, style, class: className } = Astro.props;
---

{
  image && (
    <div class:list={['cutout', className]} style={style}>
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        sizes={sizes}
        widths={[400, 640, 900, 1200, 1480]}
        layout="none"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="block h-auto w-full"
      />
    </div>
  )
}

<style>
  .cutout {
    filter: drop-shadow(0 1.75rem 2rem rgb(43 27 18 / 0.22)) drop-shadow(0 0.375rem 0.625rem rgb(43 27 18 / 0.16));
  }
</style>
