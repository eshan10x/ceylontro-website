---
/**
 * Temporary home page for the B1 foundation. Replaced by the full Home page in B4,
 * and kept out of search results until then.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import Logo from '@/components/ui/Logo.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import OrderButton from '@/components/ui/OrderButton.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
---

<BaseLayout noindex>
  <main id="main">
    <Section surface="hero" class="flex min-h-svh items-center">
      <Container class="flex flex-col items-center gap-10 text-center">
        <Logo size={120} priority alt="" />
        <SectionHeading eyebrow={site.name} level={1} size="display-xl" align="center">
          Flavours <i>Beyond</i> Borders
        </SectionHeading>
        <div class="flex w-full max-w-sm flex-col gap-3 md:max-w-none md:flex-row md:justify-center">
          <OrderButton />
          <Button href="/styleguide" variant="secondary">Style guide</Button>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>
