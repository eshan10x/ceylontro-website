---
/**
 * Checkout, step 2 of 3 (O2 "pickup details"): pickup time, the guest's details, a note for the
 * kitchen and the order summary, then Clover's secure payment page (step 3).
 *
 * A focused page: slim header with Back, no footer. Everything that depends on the guest's order
 * or the time of day is filled in by `src/scripts/order/checkout.ts`; the server re-checks it all.
 * Never indexed.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/ui/Logo.astro';
import '@/styles/order.css';
import { restaurant } from '@/data/restaurant';
import { ORDERING } from '@/ordering/config';
import { addressQuery, formatPeriods, groupHours, phoneHref } from '@/lib/format';

const hours = groupHours(restaurant.hours);
const hoursText = hours.length === 1 && hours[0]?.days.length === 7 ? `${formatPeriods(restaurant.hours.monday ?? [])} every day` : null;
const fieldClass = 'flex flex-col gap-2';
const labelClass = 'text-[0.8125rem] font-semibold';
---

<BaseLayout title="Checkout" noindex>
  <header class="sticky top-0 z-40 border-b border-line-soft bg-white/95 backdrop-blur-md">
    <div class="mx-auto grid h-17 max-w-5xl grid-cols-[1fr_auto_1fr] items-center px-4 md:px-10">
      <a
        href="/menu#your-order"
        class="grid size-11 place-content-center rounded-full bg-sand text-ink hover:bg-sand-hover"
        aria-label="Back to your order"
      >
        <svg width="16" height="14" viewBox="0 0 16 14" aria-hidden="true"
          ><path d="M7 1L1 7l6 6M1 7h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        >
      </a>
      <a href="/" class="rounded-logo" aria-label={`${restaurant.name} — home`}><Logo size={40} alt="" class="size-10" /></a>
      <span></span>
    </div>
  </header>

  <main id="main" tabindex="-1" class="outline-none">
    <form
      data-checkout
      novalidate
      class="mx-auto grid max-w-5xl gap-8 px-5 pt-7 pb-40 md:px-10 md:pt-10 lg:grid-cols-[minmax(0,1fr)_22.5rem] lg:gap-14 lg:pb-24"
    >
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <ol class="flex gap-4.5 text-[0.6875rem] font-semibold tracking-[0.14em] text-stone uppercase" aria-label="Checkout steps">
            <li class="flex items-center gap-2">
              <span class="grid size-5.5 place-content-center rounded-full bg-sand text-espresso">1</span>Order
            </li>
            <li class="flex items-center gap-2 text-espresso" aria-current="step">
              <span class="grid size-5.5 place-content-center rounded-full bg-espresso text-white">2</span>Details
            </li>
            <li class="flex items-center gap-2"><span class="grid size-5.5 place-content-center rounded-full border border-line">3</span>Pay</li>
          </ol>
          <h1 class="text-[2.75rem] leading-[0.98] md:text-[3.5rem]">Pickup <i>details</i></h1>
        </div>

        <div data-checkout-alert role="alert" class="empty:hidden"></div>

        <fieldset data-pickup class="flex flex-col gap-3">
          <legend class="label pb-3 text-ink">Pickup time</legend>
          <label class="pickup-choice flex cursor-pointer items-start gap-3.5 rounded-[1.125rem] border border-line bg-white p-4">
            <input type="radio" name="when" value="asap" checked class="mt-0.5" />
            <span class="flex flex-col gap-1">
              <b class="text-[0.9375rem] font-semibold">As soon as possible</b>
              <span class="text-[0.8125rem] text-stone" data-asap-text>Ready in about {ORDERING.prepMinutes} minutes</span>
            </span>
          </label>
          <label class="pickup-choice flex cursor-pointer items-start gap-3.5 rounded-[1.125rem] border border-line bg-white p-4">
            <input type="radio" name="when" value="scheduled" class="mt-0.5" />
            <span class="flex grow flex-col gap-1">
              <b class="text-[0.9375rem] font-semibold">Schedule for later today</b>
              <span class="text-[0.8125rem] text-stone" data-slots-hint>Choose a time below.</span>
            </span>
          </label>
          <div data-slots hidden class="flex flex-wrap gap-2 pt-1" role="radiogroup" aria-label="Pickup times"></div>
          {
            hoursText && (
              <p class="flex items-center gap-2 pt-1 text-[0.75rem] text-stone">
                <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true" class="text-gold-deep">
                  <circle cx="9" cy="9" r="7.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                  <path d="M9 4.5V9l3 2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                </svg>
                Open {hoursText}. Last online order {ORDERING.lastOrderBeforeCloseMinutes} minutes before closing.
              </p>
            )
          }
        </fieldset>

        <fieldset class="flex flex-col gap-4">
          <legend class="label pb-3 text-ink">Your details</legend>
          <div class={fieldClass}>
            <label for="co-name" class={labelClass}>Name</label>
            <input id="co-name" name="name" class="order-field" autocomplete="name" required maxlength="60" aria-describedby="co-name-error" />
            <p id="co-name-error" class="text-[0.75rem] font-semibold text-[#9a2a1c] empty:hidden"></p>
          </div>
          <div class={fieldClass}>
            <label for="co-phone" class={labelClass}>Mobile number</label>
            <input
              id="co-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              class="order-field"
              autocomplete="tel"
              required
              maxlength="20"
              aria-describedby="co-phone-error co-phone-hint"
            />
            <p id="co-phone-hint" class="text-[0.75rem] text-stone">We’ll only call if there’s a question about your order.</p>
            <p id="co-phone-error" class="text-[0.75rem] font-semibold text-[#9a2a1c] empty:hidden"></p>
          </div>
          <div class={fieldClass}>
            <label for="co-email" class={labelClass}>Email</label>
            <input
              id="co-email"
              name="email"
              type="email"
              class="order-field"
              autocomplete="email"
              required
              maxlength="254"
              aria-describedby="co-email-error co-email-hint"
            />
            <p id="co-email-hint" class="text-[0.75rem] text-stone">Your receipt goes here.</p>
            <p id="co-email-error" class="text-[0.75rem] font-semibold text-[#9a2a1c] empty:hidden"></p>
          </div>
          <div class={fieldClass}>
            <label for="co-note" class={labelClass}>Note for the kitchen <span class="ml-1.5 text-[0.75rem] font-normal text-stone">Optional</span></label>
            <textarea id="co-note" name="note" class="order-field" rows="3" maxlength={ORDERING.notes.maxLength} placeholder="Allergies or anything we should know"
            ></textarea>
          </div>
        </fieldset>
      </div>

      <div class="flex flex-col gap-5 lg:sticky lg:top-24 lg:self-start">
        <section aria-labelledby="co-summary" class="flex flex-col gap-2.5 rounded-[1.5rem] bg-linen p-5 md:p-6">
          <div class="flex items-baseline justify-between">
            <h2 id="co-summary" class="label text-ink">Summary</h2>
            <a
              href="/menu#your-order"
              class="inline-flex min-h-11 items-center gap-2.5 text-[0.6875rem] font-semibold tracking-[0.12em] text-espresso uppercase after:h-px after:w-5 after:bg-gold"
              >Edit</a
            >
          </div>
          <div data-summary class="flex flex-col gap-2.5 text-[0.875rem] tabular-nums"></div>
        </section>

        {
          restaurant.address && (
            <p class="flex items-start gap-3 px-1 text-[0.8125rem] text-stone">
              <svg width="16" height="18" viewBox="0 0 16 18" aria-hidden="true" class="mt-0.5 shrink-0 text-gold-deep">
                <path d="M8 17s6-5.2 6-9.5A6 6 0 0 0 2 7.5C2 11.8 8 17 8 17z" fill="none" stroke="currentColor" stroke-width="1.4" />
                <circle cx="8" cy="7.5" r="2" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
              <span>
                Pickup at <b class="font-semibold text-ink">{restaurant.name}</b>, {addressQuery(restaurant.address)}
              </span>
            </p>
          )
        }

        <div class="flex items-start gap-3 rounded-2xl border border-line-soft bg-linen px-4 py-3.5">
          <svg width="16" height="18" viewBox="0 0 16 18" aria-hidden="true" class="mt-0.5 shrink-0 text-espresso">
            <rect x="1.5" y="8" width="13" height="9" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M4.5 8V5.5a3.5 3.5 0 0 1 7 0V8" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <p class="text-[0.8125rem] leading-normal">
            You’ll pay on Clover’s secure checkout page. {restaurant.name} never sees your card details.
          </p>
        </div>

        <div
          class="fixed inset-x-0 bottom-0 z-30 border-t border-line-soft bg-white/95 px-4 pt-3 pb-[max(0.875rem,env(safe-area-inset-bottom))] shadow-[0_-16px_30px_-24px_rgb(43_27_18/0.5)] backdrop-blur-md lg:static lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none"
        >
          <button
            type="submit"
            data-checkout-submit
            class="mx-auto flex min-h-[3.375rem] w-full max-w-md items-center justify-between gap-3 rounded-full bg-espresso px-6 text-button font-semibold tracking-[0.12em] text-white uppercase shadow-button transition-colors hover:bg-espresso-hover disabled:bg-line disabled:text-stone disabled:shadow-none lg:max-w-none"
          >
            <span data-submit-label>Continue to payment</span>
            <span class="text-[0.9375rem] tracking-normal tabular-nums" data-submit-total></span>
          </button>
        </div>
        {
          restaurant.phone && (
            <p class="px-1 text-[0.75rem] text-stone">
              Questions? Call <a href={phoneHref(restaurant.phone)} class="font-semibold text-ink underline underline-offset-3">{restaurant.phone}</a>.
            </p>
          )
        }
      </div>
    </form>
  </main>

</BaseLayout>

<style>
  .pickup-choice input,
  [data-slots] input {
    appearance: none;
    margin: 0.125rem 0 0;
    flex: 0 0 1.375rem;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    border: 1.5px solid #b9ae9f;
    background: var(--color-white);
  }

  .pickup-choice input:checked {
    border-color: var(--color-espresso);
    box-shadow: inset 0 0 0 5px var(--color-espresso);
  }

  .pickup-choice:has(input:checked) {
    border-color: var(--color-espresso);
    box-shadow: 0 0 0 1px var(--color-espresso);
    background: var(--color-linen);
  }

  .pickup-choice:has(input:focus-visible),
  [data-slots] label:has(input:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  [data-slots] input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  [data-slots] label:has(input:checked) {
    background: var(--color-espresso);
    border-color: var(--color-espresso);
    color: var(--color-white);
  }
</style>

<script>
  import '@/scripts/order/checkout';
</script>
