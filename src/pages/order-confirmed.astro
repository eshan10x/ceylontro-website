---
/**
 * Order confirmed (O2 "confirmation"): after a pay-at-pickup order is placed, or where Clover
 * sends the guest after a successful online payment.
 * Shows the order reference, pickup time, what was ordered, and how to find and call the
 * restaurant. The details come from this device (saved just before payment) and are filled in by
 * `src/scripts/order/confirmed.ts`, which also empties the order. Never indexed.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import '@/styles/order.css';
import { restaurant } from '@/data/restaurant';
import { addressQuery, directionsHref, phoneHref } from '@/lib/format';
---

<PageLayout title="Order received" noindex>
  <section class="surface-dark grain on-dark px-6 pt-12 pb-11 text-center md:pt-16 md:pb-14">
    <div class="relative z-10 mx-auto flex max-w-xl flex-col items-center gap-4">
      <span class="grid size-14 place-content-center rounded-full bg-cream text-espresso">
        <svg width="22" height="18" viewBox="0 0 12 10" aria-hidden="true"
          ><path d="M1 5l3.5 3.5L11 1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        >
      </span>
      <p class="eyebrow text-gold-light" data-confirm-ref>Order received</p>
      <h1 class="text-[3rem] leading-[0.98] text-cream md:text-[4rem]" data-confirm-title>Thank <i>you</i></h1>
      <p class="max-w-sm text-small text-cream-muted" data-confirm-lead>Your order is in the kitchen.</p>
      <div data-confirm-pickup hidden class="mt-2 flex flex-col gap-1 rounded-[1.375rem] border border-gold-light/45 px-7 py-4.5">
        <span class="label text-cream-muted">Ready for pickup</span>
        <span class="font-display text-[2.125rem] leading-tight text-cream" data-confirm-time></span>
      </div>
    </div>
  </section>

  <section class="mx-auto flex max-w-xl flex-col gap-7 px-5 pt-9 pb-20 md:px-0">
    {
      restaurant.address && (
        <div class="flex flex-col gap-1.5">
          <h2 class="label text-ink">Pick up at</h2>
          <p class="font-semibold">{restaurant.name}</p>
          <p class="text-small text-stone">{addressQuery(restaurant.address)}</p>
          <div class="flex flex-wrap gap-2.5 pt-3">
            <Button href={directionsHref(restaurant.address)} external variant="secondary" size="sm" class="min-h-12 px-5">
              Directions
            </Button>
            {restaurant.phone && (
              <Button href={phoneHref(restaurant.phone)} variant="secondary" size="sm" class="min-h-12 px-5">
                Call {restaurant.phone}
              </Button>
            )}
          </div>
        </div>
      )
    }

    <div class="flex items-center gap-2.5" aria-hidden="true">
      <i class="block h-px w-12 bg-gold"></i><b class="block size-1.75 rotate-45 border border-gold"></b><i class="block h-px w-12 bg-gold"></i>
    </div>

    <div data-confirm-order hidden class="flex flex-col gap-2.5">
      <h2 class="label text-ink">Your order</h2>
      <div data-confirm-lines class="flex flex-col gap-2.5 text-[0.875rem] tabular-nums"></div>
    </div>

    <p class="text-[0.8125rem] text-stone" data-confirm-help>
      {restaurant.phone && <>Need to change something? Call us on {restaurant.phone}.</>}
    </p>

    <Button href="/menu" fullWidth>Back to the menu</Button>
  </section>
</PageLayout>

<script>
  import '@/scripts/order/confirmed';
</script>
