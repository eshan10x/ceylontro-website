---
/**
 * 404 — page not found. Static hosts (Netlify, Cloudflare Pages, Vercel) serve `404.html`
 * automatically. Kept out of search results.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Section from '@/components/layout/Section.astro';
import Container from '@/components/layout/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { copy } from '@/data/copy';

import { splitAccent } from '@/lib/text';

const { lead, accent } = splitAccent(copy.notFoundHeading.text);
---

<PageLayout title="Page not found" noindex overlayHeader>
  <Section surface="hero" padded={false} class="pt-header" labelledby="not-found-title">
    <Container class="relative flex min-h-[calc(100svh-var(--header-h))] flex-col items-center justify-center gap-7 py-20 text-center md:gap-8">
      <div
        aria-hidden="true"
        class="rounded-arch pointer-events-none absolute top-1/2 left-1/2 aspect-[4/5] w-[min(86%,30rem)] -translate-x-1/2 -translate-y-1/2 border border-b-0 border-gold/45"
      >
      </div>
      <Eyebrow class="relative">Error 404</Eyebrow>
      <h1 id="not-found-title" class="relative max-w-[12ch] text-display-l text-ink">
        {lead}{' '}<i>{accent}</i>
      </h1>
      <p class="relative max-w-md text-stone">{copy.notFoundBody.text}</p>
      <div class="relative flex w-full max-w-xs flex-col items-center gap-3 pt-2 md:max-w-none md:flex-row md:justify-center md:gap-8">
        <Button href="/menu" variant="secondary" fullWidth class="md:w-auto">View Menu</Button>
        <TextLink href="/">Back to home</TextLink>
      </div>
    </Container>
  </Section>
</PageLayout>
