---
/**
 * Menu (D3 "MenuMobile" / "MenuDesktop"; ordering from O2): intro, then every category from
 * `src/data/menu.ts`.
 * Mobile and tablet: sticky category bar; with ordering on, Add buttons and a View order bar.
 * Desktop: a sticky category list beside the menu, and from 1440 px the order panel on the right.
 * `menu-nav.ts` marks the category in view; `order/boot.ts` runs ordering.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/layout/Container.astro';
import MenuIntro from '@/components/menu/MenuIntro.astro';
import MenuCategoryBar from '@/components/menu/MenuCategoryBar.astro';
import MenuSideNav from '@/components/menu/MenuSideNav.astro';
import MenuCategory from '@/components/menu/MenuCategory.astro';
import MobileOrderBar from '@/components/menu/MobileOrderBar.astro';
import OrderBar from '@/components/order/OrderBar.astro';
import OrderDialogs from '@/components/order/OrderDialogs.astro';
import OrderPanel from '@/components/order/OrderPanel.astro';
import OrderClosedNotice from '@/components/order/OrderClosedNotice.astro';
import { copy } from '@/data/copy';
import { menu } from '@/data/menu';
import { ORDERING } from '@/ordering/config';
---

<PageLayout title="Menu" description={copy.menuMeta.text} overlayHeader structuredData={['menu']}>
  <MenuIntro />

  <div id="order-start" class="menu-body relative scroll-mt-0">
    <MenuCategoryBar categories={menu} />

    <Container
      class:list={[
        'pt-10 pb-18 md:pt-14 md:pb-24 lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-12 lg:pt-18 lg:pb-35',
        ORDERING.enabled
          ? 'xl:grid-cols-[13rem_minmax(0,1fr)_22.5rem] xl:gap-12'
          : 'xl:grid-cols-[15.625rem_minmax(0,1fr)] xl:gap-20',
      ]}
    >
      <aside class="hidden lg:block">
        <MenuSideNav categories={menu} />
      </aside>

      <div class="flex flex-col gap-18 md:gap-24 lg:gap-28">
        {ORDERING.enabled && <OrderClosedNotice class="-mb-6 md:-mb-10 lg:-mb-12" />}
        {menu.map((category, index) => <MenuCategory category={category} index={index + 1} total={menu.length} />)}
      </div>

      {ORDERING.enabled && <OrderPanel />}
    </Container>

    {ORDERING.enabled ? <OrderBar /> : <MobileOrderBar />}
  </div>

  {ORDERING.enabled && <OrderDialogs />}
</PageLayout>

<script>
  import '@/scripts/menu-nav';
  import '@/scripts/order/boot';
</script>
